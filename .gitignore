# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated verification/export artifacts; private archives are never distributed.
/.next-*/
/work/verification-archive/
/work/verification-runs/
/work/project-snapshots/
/work/integration-observability/
/work/stripe-view-control-*/
/work/stripe-guard-*/

