!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-proposal-review/
/.next-credentials-build-*/
/.next-history-build-*/
/.next-appmon-verify-*/
/out/

# production
/build
/packages/express-monitoring/dist/
/work/express-monitoring/
/work/historical-guard-*/
/work/historical-runtime/
/work/sender-package-review-*/
/work/sender-runtime/
