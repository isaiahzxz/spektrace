generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IncidentSource {
  SENTRY
  DATADOG
  CLOUDWATCH
  WEBHOOK

  @@map("incident_source")
}

enum IncidentStatus {
  RECEIVED
  VALIDATING
  NEEDS_REVIEW
  DRAFT_READY
  APPROVED
  SENDING
  SENT
  FAILED

  @@map("incident_status")
}

enum ValidationStatus {
  NOT_RUN
  PASSED
  MISMATCH
  UNSUPPORTED
  ERROR

  @@map("validation_status")
}

enum AuditEventType {
  INTEGRATION_OBSERVATION_RECEIVED
  INTEGRATION_BASELINE_CREATED
  INTEGRATION_BASELINE_ACTIVATED
  INTEGRATION_OUTCOME_RECEIVED
  INCIDENT_RECEIVED
  SPEC_REGISTERED
  SPEC_ACTIVATED
  VALIDATION_STARTED
  VALIDATION_COMPLETED
  VALIDATION_FAILED
  DRAFT_GENERATED
  DRAFT_EDITED
  INCIDENT_APPROVED
  SEND_SUCCEEDED
  SEND_FAILED
  PATTERN_SEVERITY_SET
  REPOSITORY_SNAPSHOT_IMPORTED
  DOCUMENTATION_SNAPSHOT_IMPORTED
  DEPLOYMENT_EVENT_RECORDED
  HISTORICAL_BINDING_IMPORTED
  SENDER_BINDING_REGISTERED
  SENDER_BINDING_REVOKED
  INGESTION_CREDENTIAL_ISSUED
  INGESTION_CREDENTIAL_REVOKED
  INGESTION_CREDENTIAL_ROTATED

  @@map("audit_event_type")
}

enum DeploymentEventStatus {
  STARTED
  SUCCEEDED
  FAILED
  CANCELLED
  ROLLED_BACK

  @@map("deployment_event_status")
}

enum DocumentationSnapshotImportStatus {
  COMPLETE
  PARTIAL

  @@map("documentation_snapshot_import_status")
}

enum RepositorySnapshotImportStatus {
  COMPLETE
  PARTIAL

  @@map("repository_snapshot_import_status")
}

enum ActorType {
  SYSTEM
  HUMAN

  @@map("actor_type")
}

enum OutboxDispatchStatus {
  PENDING
  CLAIMED
  PUBLISHED
  FAILED

  @@map("outbox_dispatch_status")
}

enum OutboxEventType {
  INTEGRATION_OBSERVATION_REQUESTED
  INTEGRATION_OUTCOME_REQUESTED
  STRIPE_WEBHOOK_VALIDATION_REQUESTED
  WEBHOOK_VALIDATION_REQUESTED
  INCIDENT_VALIDATION_REQUESTED
  INCIDENT_INVESTIGATION_GROUPING_REQUESTED
  INVESTIGATION_GROUP_PREPARATION_REQUESTED
  INVESTIGATION_GROUP_INFERENCE_REQUESTED

  @@map("outbox_event_type")
}

enum EvidencePreparationRunStatus {
  PENDING
  RUNNING
  EVIDENCE_READY
  FAILED

  @@map("evidence_preparation_run_status")
}

enum InvestigationInferenceRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED

  @@map("investigation_inference_run_status")
}

model Workspace {
  accountOwner AccountWorkspace?
  plannedIntegrations PlannedIntegration[]
  notificationPreference NotificationPreference?
  notificationGroups NotificationGroup[]
  notificationDeliveries NotificationDelivery[]
  integrationObservations IntegrationObservation[]
  integrationResponseBaselines IntegrationResponseBaseline[]
  integrationWorkflowOutcomes IntegrationWorkflowOutcome[]
  integrationOutcomeLinks IntegrationOutcomeLink[]
  integrationCoverage IntegrationCoverage[]
  stripeIntegrations StripeWebhookIntegration[]
  stripeReceipts StripeWebhookReceipt[]
  webhookDriftGroups WebhookDriftGroup[]
  webhookGroupingDecisions WebhookGroupingDecision[]
  webhookReceipts WebhookReceipt[]
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  apiSpecs     ApiSpec[]
  ingestionCredentials IngestionCredential[]
  incidents    Incident[]
  auditLogs    AuditLog[]
  outboxEvents OutboxEvent[]
  patternSeverities PatternSeverityAssignment[]
  investigationGroups InvestigationGroup[]
  investigationGroupMemberships InvestigationGroupMembership[]
  evidencePreparationRuns EvidencePreparationRun[]
  investigationInferenceRuns InvestigationInferenceRun[]
  repositoryContextSnapshots RepositoryContextSnapshot[]
  repositorySnapshotFiles RepositorySnapshotFile[]
  repositoryServiceFileMappings RepositoryServiceFileMapping[]
  documentationContextSnapshots DocumentationContextSnapshot[]
  documentationSnapshotDocuments DocumentationSnapshotDocument[]
  documentationServiceTopicMappings DocumentationServiceTopicMapping[]
  deploymentRecords DeploymentRecord[]
  contractRevisionIntervals ContractRevisionInterval[]
  deploymentStatusEvents DeploymentStatusEvent[]
  senders WorkspaceSender[]
  senderBindings SenderBinding[]

  @@map("workspaces")
}

model IngestionCredential {
  integrationObservations IntegrationObservation[]
  integrationWorkflowOutcomes IntegrationWorkflowOutcome[]
  integrationCoverage IntegrationCoverage[]
  stripeIntegrations StripeWebhookIntegration[]
  stripeReceipts StripeWebhookReceipt[]
  webhookReceipts WebhookReceipt[]
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  name String @db.VarChar(80)
  tokenSha256 String @map("token_sha256") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  senderBindings SenderBinding[]
  collectedIncidents Incident[]

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
  @@map("ingestion_credentials")
}

model ApiSpec {
  integrationResponseBaselines IntegrationResponseBaseline[]
  webhookDriftGroups WebhookDriftGroup[]
  webhookReceipts WebhookReceipt[]
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  apiKey         String   @map("api_key")
  name           String
  version        String
  openApiVersion String   @map("open_api_version")
  sourceFilename String   @map("source_filename")
  sourceText     String   @map("source_text")
  sourceSha256   String   @map("source_sha256")
  parsedDocument Json     @map("parsed_document") @db.JsonB
  environment    String   @default("default")
  revisionSequence Int    @default(0) @map("revision_sequence")
  provenance     Json?
  isActive       Boolean  @default(false) @map("is_active")
  activatedAt    DateTime? @map("activated_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  incidents Incident[]
  contractRevisionIntervals ContractRevisionInterval[]
  investigationGroups InvestigationGroup[]

  @@unique([workspaceId, apiKey, environment, version])
  @@unique([workspaceId, apiKey, environment, sourceSha256])
  @@unique([workspaceId, id])
  @@index([workspaceId, apiKey, environment, isActive])
  @@map("api_specs")
}

model Incident {
  integrationObservations IntegrationObservation[]
  id                     String           @id @default(uuid()) @db.Uuid
  workspaceId            String           @map("workspace_id") @db.Uuid
  apiKey                 String           @map("api_key")
  environment            String           @default("default")
  applicationName        String?          @map("application_name")
  applicationVersion     String?          @map("application_version")
  platform               String?
  sdkName                String?          @map("sdk_name")
  sdkVersion             String?          @map("sdk_version")
  apiSpecId              String?          @map("api_spec_id") @db.Uuid
  source                 IncidentSource
  revisionSelectionMode String? @map("revision_selection_mode")
  revisionSelection Json? @map("revision_selection") @db.JsonB
  collectorCredentialId String? @map("collector_credential_id") @db.Uuid
  senderId String? @map("sender_id") @db.Uuid
  senderBindingId String? @map("sender_binding_id") @db.Uuid
  senderClaim Json? @map("sender_claim") @db.JsonB
  reportedClientRef String? @map("reported_client_ref") @db.Uuid
  senderProvenance Json? @map("sender_provenance") @db.JsonB
  sourceEventId          String           @map("source_event_id")
  httpMethod             String           @map("http_method")
  requestPath            String           @map("request_path")
  statusCode             Int              @map("status_code")
  clientReference        String?          @map("client_reference")
  sanitizedRequestBody   Json?            @map("sanitized_request_body") @db.JsonB
  status                 IncidentStatus   @default(RECEIVED)
  validationStatus       ValidationStatus @default(NOT_RUN) @map("validation_status")
  validationEvidence     Json?            @map("validation_evidence") @db.JsonB
  draftText              String?          @map("draft_text") @db.Text
  draftCitations         Json?            @map("draft_citations") @db.JsonB
  draftVersion           Int              @default(0) @map("draft_version")
  approvedBy             String?          @map("approved_by")
  approvedAt             DateTime?        @map("approved_at") @db.Timestamptz(6)
  approvedDraftVersion   Int?             @map("approved_draft_version")
  sentAt                 DateTime?        @map("sent_at") @db.Timestamptz(6)
  processingErrorCode    String?          @map("processing_error_code")
  processingErrorMessage String?          @map("processing_error_message") @db.Text
  occurredAt             DateTime         @map("occurred_at") @db.Timestamptz(6)
  receivedAt             DateTime         @default(now()) @map("received_at") @db.Timestamptz(6)
  validatedAt            DateTime?        @map("validated_at") @db.Timestamptz(6)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  apiSpec      ApiSpec?      @relation(fields: [workspaceId, apiSpecId], references: [workspaceId, id], onDelete: Restrict)
  auditLogs    AuditLog[]
  outboxEvents OutboxEvent[]
  investigationGroupMemberships InvestigationGroupMembership[]
  collectorCredential IngestionCredential? @relation(fields: [workspaceId, collectorCredentialId], references: [workspaceId, id], onDelete: Restrict, map: "incidents_collector_fk")
  sender WorkspaceSender? @relation(fields: [workspaceId, senderId], references: [workspaceId, id], onDelete: Restrict, map: "incidents_sender_fk")
  senderBinding SenderBinding? @relation(fields: [workspaceId, senderBindingId], references: [workspaceId, id], onDelete: Restrict, map: "incidents_sender_binding_fk")

  @@unique([workspaceId, source, sourceEventId])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, receivedAt])
  @@index([workspaceId, occurredAt])
  @@index([workspaceId, apiSpecId])
  @@index([workspaceId, apiKey, environment, receivedAt])
  @@index([workspaceId, senderId, receivedAt])
  @@map("incidents")
}

model OutboxEvent {
  integrationObservationId String? @map("integration_observation_id") @db.Uuid
  integrationOutcomeId String? @map("integration_outcome_id") @db.Uuid
  integrationObservation IntegrationObservation? @relation(fields: [workspaceId, integrationObservationId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "outbox_integration_observation_fk")
  integrationOutcome IntegrationWorkflowOutcome? @relation(fields: [workspaceId, integrationOutcomeId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "outbox_integration_outcome_fk")
  @@index([workspaceId, integrationObservationId], map: "outbox_integration_observation_idx")
  @@index([workspaceId, integrationOutcomeId], map: "outbox_integration_outcome_idx")
  stripeWebhookReceiptId String? @map("stripe_webhook_receipt_id") @db.Uuid
  stripeWebhookReceipt StripeWebhookReceipt? @relation(fields: [workspaceId, stripeWebhookReceiptId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "outbox_stripe_workspace_fk")
  webhookReceiptId String? @map("webhook_receipt_id") @db.Uuid
  webhookReceipt WebhookReceipt? @relation(fields: [workspaceId, webhookReceiptId], references: [workspaceId, id], onDelete: Restrict)
  id                   String               @id @default(uuid()) @db.Uuid
  workspaceId          String               @map("workspace_id") @db.Uuid
  incidentId           String?              @map("incident_id") @db.Uuid
  investigationGroupId String?              @map("investigation_group_id") @db.Uuid
  evidencePreparationRunId String?          @map("evidence_preparation_run_id") @db.Uuid
  dedupeKey            String               @map("dedupe_key")
  eventType            OutboxEventType      @default(INCIDENT_VALIDATION_REQUESTED) @map("event_type")
  dispatchStatus       OutboxDispatchStatus @default(PENDING) @map("dispatch_status")
  attemptCount         Int                  @default(0) @map("attempt_count")
  claimedAt            DateTime?            @map("claimed_at") @db.Timestamptz(6)
  claimExpiresAt       DateTime?            @map("claim_expires_at") @db.Timestamptz(6)
  claimedBy            String?              @map("claimed_by")
  publishedAt          DateTime?            @map("published_at") @db.Timestamptz(6)
  lastError            String?              @map("last_error") @db.Text
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  incident           Incident?           @relation(fields: [workspaceId, incidentId], references: [workspaceId, id], onDelete: Restrict)
  investigationGroup InvestigationGroup? @relation(fields: [workspaceId, investigationGroupId], references: [workspaceId, id], onDelete: Restrict)
  evidencePreparationRun EvidencePreparationRun? @relation(fields: [workspaceId, evidencePreparationRunId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, webhookReceiptId])
  @@index([workspaceId, stripeWebhookReceiptId], map: "outbox_stripe_receipt_idx")
  @@index([dispatchStatus, claimExpiresAt, createdAt])
  @@map("outbox_events")
}

model StripeWebhookIntegration {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  ingestionCredentialId String @map("ingestion_credential_id") @db.Uuid
  mode String @default("test")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  credential IngestionCredential @relation(fields: [workspaceId, ingestionCredentialId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "stripe_webhook_integrations_workspace_id_ingestion_credent_fkey")
  receipts StripeWebhookReceipt[]
  @@unique([workspaceId, id])
  @@index([workspaceId, ingestionCredentialId], map: "stripe_integrations_credential_idx")
  @@map("stripe_webhook_integrations")
}

model StripeWebhookReceipt {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  integrationId String @map("integration_id") @db.Uuid
  collectorCredentialId String @map("collector_credential_id") @db.Uuid
  sourceEventId String @map("source_event_id") @db.VarChar(100)
  eventType String @map("event_type") @db.VarChar(64)
  eventCreatedAt DateTime @map("event_created_at") @db.Timestamptz(6)
  reportedApiVersion String? @map("reported_api_version") @db.VarChar(64)
  protectedShape Json @map("protected_shape") @db.JsonB
  verification Json @db.JsonB
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  validationStatus ValidationStatus @default(NOT_RUN) @map("validation_status")
  validationEvidence Json? @map("validation_evidence") @db.JsonB
  validatedAt DateTime? @map("validated_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  integration StripeWebhookIntegration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)
  collector IngestionCredential @relation(fields: [workspaceId, collectorCredentialId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "stripe_webhook_receipts_workspace_id_collector_credential__fkey")
  outboxEvents OutboxEvent[]
  @@unique([workspaceId, id])
  @@unique([workspaceId, integrationId, sourceEventId])
  @@index([workspaceId, receivedAt], map: "stripe_receipts_received_idx")
  @@map("stripe_webhook_receipts")
}

model WebhookReceipt {
  groupingDecision WebhookGroupingDecision?
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  collectorCredentialId String @map("collector_credential_id") @db.Uuid
  sourceEventId String @map("source_event_id") @db.Uuid
  apiKey String @map("api_key")
  environment String
  operationPath String @map("operation_path")
  sanitizedPayload Json @map("sanitized_payload") @db.JsonB
  protection Json @db.JsonB
  apiSpecId String? @map("api_spec_id") @db.Uuid
  revisionSelection Json @map("revision_selection") @db.JsonB
  senderVerification Json? @map("sender_verification") @db.JsonB
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  validationStatus ValidationStatus @default(NOT_RUN) @map("validation_status")
  validationEvidence Json? @map("validation_evidence") @db.JsonB
  validatedAt DateTime? @map("validated_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  collector IngestionCredential @relation(fields: [workspaceId, collectorCredentialId], references: [workspaceId, id], onDelete: Restrict)
  apiSpec ApiSpec? @relation(fields: [workspaceId, apiSpecId], references: [workspaceId, id], onDelete: Restrict)
  outboxEvents OutboxEvent[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, collectorCredentialId, sourceEventId])
  @@index([workspaceId, receivedAt])
  @@index([workspaceId, apiSpecId])
  @@map("webhook_receipts")
}

model WebhookDriftGroup {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  apiKey String @map("api_key")
  environment String
  httpMethod String @map("http_method")
  operationPath String @map("operation_path")
  senderId String @map("sender_id") @db.Uuid
  apiSpecId String @map("api_spec_id") @db.Uuid
  sourceSha256 String @map("source_sha256")
  driftFingerprint String @map("drift_fingerprint")
  groupingVersion Int @map("grouping_version")
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  windowEnd DateTime @map("window_end") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sender WorkspaceSender @relation(fields: [workspaceId, senderId], references: [workspaceId, id], onDelete: Restrict)
  apiSpec ApiSpec @relation(fields: [workspaceId, apiSpecId], references: [workspaceId, id], onDelete: Restrict)
  decisions WebhookGroupingDecision[]
  @@unique([workspaceId, id])
  @@unique([workspaceId, apiKey, environment, operationPath, senderId, apiSpecId, sourceSha256, driftFingerprint, windowStart, groupingVersion], map: "webhook_drift_dimensions_key")
  @@index([workspaceId, senderId, windowStart], map: "webhook_drift_sender_idx")
  @@index([workspaceId, apiSpecId], map: "webhook_drift_spec_idx")
  @@map("webhook_drift_groups")
}

model WebhookGroupingDecision {
  receiptId String @id @map("receipt_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  groupId String? @map("group_id") @db.Uuid
  reason String
  groupingVersion Int @map("grouping_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  receipt WebhookReceipt @relation(fields: [workspaceId, receiptId], references: [workspaceId, id], onDelete: Restrict)
  group WebhookDriftGroup? @relation(fields: [workspaceId, groupId], references: [workspaceId, id], onDelete: Restrict)
  @@unique([workspaceId, receiptId])
  @@index([workspaceId, groupId], map: "webhook_decision_group_idx")
  @@map("webhook_grouping_decisions")
}

model InvestigationGroup {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  apiKey             String   @map("api_key")
  environment        String
  httpMethod         String   @map("http_method")
  operationIdentity  String   @map("operation_identity")
  apiSpecId          String?  @map("api_spec_id") @db.Uuid
  pinnedApiSpecKey   String   @map("pinned_api_spec_key")
  findingSignature   String   @map("finding_signature")
  groupingVersion Int @default(1) @map("grouping_version")
  senderGroupingKey String @default("__legacy_unspecified__") @map("sender_grouping_key")
  senderId String? @map("sender_id") @db.Uuid
  windowStart        DateTime @map("window_start") @db.Timestamptz(6)
  windowEnd          DateTime @map("window_end") @db.Timestamptz(6)
  membershipVersion  Int      @default(0) @map("membership_version")
  preparedMembershipVersion Int @default(0) @map("prepared_membership_version")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace          Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  apiSpec            ApiSpec?                       @relation(fields: [workspaceId, apiSpecId], references: [workspaceId, id], onDelete: Restrict)
  sender WorkspaceSender? @relation(fields: [workspaceId, senderId], references: [workspaceId, id], onDelete: Restrict, map: "investigation_group_sender_fk")
  memberships        InvestigationGroupMembership[]
  preparationRuns    EvidencePreparationRun[]
  inferenceRuns      InvestigationInferenceRun[]
  outboxEvents       OutboxEvent[]

  inferredMembershipVersion Int @default(0) @map("inferred_membership_version")

  @@unique([workspaceId, id])
  @@unique([workspaceId, apiKey, environment, httpMethod, operationIdentity, pinnedApiSpecKey, findingSignature, windowStart, groupingVersion, senderGroupingKey], map: "investigation_groups_grouping_dimensions_key")
  @@index([workspaceId, senderId, windowStart])
  @@index([workspaceId, windowStart])
  @@map("investigation_groups")
}

model InvestigationGroupMembership {
  id                   String   @id @default(uuid()) @db.Uuid
  workspaceId          String   @map("workspace_id") @db.Uuid
  investigationGroupId String   @map("investigation_group_id") @db.Uuid
  incidentId           String   @map("incident_id") @db.Uuid
  incidentReceivedAt   DateTime @map("incident_received_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  investigationGroup InvestigationGroup @relation(fields: [workspaceId, investigationGroupId], references: [workspaceId, id], onDelete: Restrict)
  incident           Incident           @relation(fields: [workspaceId, incidentId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, incidentId])
  @@unique([workspaceId, investigationGroupId, incidentId])
  @@index([workspaceId, investigationGroupId, incidentReceivedAt])
  @@map("investigation_group_memberships")
}

model EvidencePreparationRun {
  id                   String                       @id @default(uuid()) @db.Uuid
  workspaceId          String                       @map("workspace_id") @db.Uuid
  investigationGroupId String                       @map("investigation_group_id") @db.Uuid
  runSequence          Int                          @map("run_sequence")
  membershipVersion    Int                          @map("membership_version")
  status               EvidencePreparationRunStatus @default(PENDING)
  includedIncidentCount Int                         @default(0) @map("included_incident_count")
  omittedIncidentCount  Int                         @default(0) @map("omitted_incident_count")
  evidenceFormatVersion Int                         @map("evidence_format_version")
  builderVersion       String                       @map("builder_version")
  protectedSummary     Json?                        @map("protected_summary") @db.JsonB
  failureCode          String?                      @map("failure_code")
  attemptCount         Int                          @default(0) @map("attempt_count")
  claimedAt            DateTime?                    @map("claimed_at") @db.Timestamptz(6)
  claimExpiresAt       DateTime?                    @map("claim_expires_at") @db.Timestamptz(6)
  claimedBy            String?                      @map("claimed_by")
  startedAt            DateTime?                    @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime?                    @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
