  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  collector IngestionCredential @relation(fields: [workspaceId, collectorCredentialId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction, map: "integration_coverage_collector_fk")
  @@unique([workspaceId, sourceEventId])
  @@unique([workspaceId, instanceId, sequence], map: "integration_coverage_sequence_key")
  @@index([workspaceId, integrationKey, environment, receivedAt], map: "integration_coverage_scope_idx")
  @@index([workspaceId, collectorCredentialId], map: "integration_coverage_collector_idx")
  @@map("integration_capture_coverage")
}

