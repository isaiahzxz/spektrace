{
  "name": "spektrace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "build:express-monitoring": "tsc -p packages/express-monitoring/tsconfig.json",
    "build:turbopack": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker": "tsx src/workers/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:check": "tsx scripts/verify-infra.ts",
    "db:ensure": "tsx scripts/ensure-databases.ts",
    "db:verify-schema": "tsx scripts/verify-schema.ts",
    "db:verify-seed": "tsx scripts/verify-seed-idempotency.ts",
    "demo:incident-flow": "tsx scripts/demo-incident-flow.ts",
    "demo:application-monitoring": "tsx scripts/demo-application-monitoring.ts",
    "ingestion:credentials": "tsx scripts/manage-ingestion-credentials.ts",
    "activate:dev-ingestion-demo": "tsx scripts/activate-dev-ingestion-demo.ts",
    "verify:application-monitoring": "tsx scripts/verify-application-monitoring.ts",
    "verify:express-monitoring": "tsx scripts/verify-express-monitoring.ts",
    "verify:historical-revisions": "tsx scripts/verify-historical-revisions.ts",
    "verify:sender-identity": "tsx scripts/verify-historical-revisions.ts --sender",
    "verify:sender-grouping": "tsx scripts/verify-historical-revisions.ts --sender --grouping",
    "verify:synthetic-webhook": "tsx scripts/verify-historical-revisions.ts --webhook",
    "verify:stripe-boundary": "tsx scripts/verify-stripe-boundary.ts",
    "demo:synthetic-webhook": "tsx scripts/demo-synthetic-webhook.ts",
    "demo:signed-synthetic-webhook": "tsx scripts/demo-signed-synthetic-webhook.ts",
    "pilot:print-workspace-id": "tsx scripts/print-pilot-workspace-id.ts",
    "backfill:investigation-inference": "tsx scripts/backfill-investigation-inference.ts",
    "verify:real-model-inference": "tsx scripts/verify-real-model-inference.ts",
    "verify:synthetic-case-c": "tsx scripts/verify-synthetic-case-c.ts",
    "verify:payload-proposal": "tsx scripts/verify-payload-proposal.ts",
    "demo:stripe-test-webhook": "tsx scripts/demo-stripe-test-webhook.ts",
    "export:snapshot": "tsx scripts/export-project-snapshot.ts",
    "verify:integration-observability": "tsx scripts/verify-integration-observability.ts",
    "review:integration-observability": "tsx --tsconfig scripts/tsconfig.server.json scripts/review-integration-observability.ts",
    "notifications:worker": "tsx --tsconfig scripts/tsconfig.server.json scripts/notification-worker.ts",
    "status": "tsx scripts/integration-status.ts",
    "verify:notifications": "tsx --tsconfig scripts/tsconfig.server.json scripts/verify-notifications.ts"
  },
  "dependencies": {
    "@openuidev/lang-core": "^1.0.1",
    "@openuidev/react-lang": "^1.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-auth": "1.7.14",
    "bullmq": "^6.3.17",
    "dotenv": "^18.0.8",
    "ioredis": "^6.0.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "daisyui": "^5.7.50",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "express": "^5.3.0",
    "express4": "npm:express@^4.22.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
